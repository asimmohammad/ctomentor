# Cal.com — Technical Risk Conversation
# Event: https://cal.com/asim-mohammad-0ydj0s/technical-risk-conversation
# Configure 24h + 1h email reminders on the Cal.com event.
# Prefill custom fields in Cal: company, driving / notes, assessmentId (hidden).
# Webhook URL: https://thectomentor.com/api/cal/webhook
#   Triggers: BOOKING_CREATED, BOOKING_RESCHEDULED, BOOKING_CANCELLED
# Success redirect (Cal event settings): https://thectomentor.com/book/confirmed
NEXT_PUBLIC_CAL_USERNAME=asim-mohammad-0ydj0s
NEXT_PUBLIC_CAL_EVENT_SLUG=technical-risk-conversation
CAL_WEBHOOK_SECRET=
CAL_API_KEY=

# Supabase
# Publishable key (sb_publishable_...) is client-safe. Secret key (sb_secret_...)
# bypasses RLS and is SERVER ONLY — never prefix it with NEXT_PUBLIC_.
# Create both in Dashboard > Settings > API Keys > "Publishable and secret API keys".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy JWT keys — deprecated by Supabase end of 2026. Read as a fallback only,
# so the new keys can be set in Vercel before these are removed. Delete both once
# the legacy keys are disabled in the dashboard.
NEXT_PUBLIC_SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=
ASSESSMENT_FROM_EMAIL=Asim Mohammad <asim@thectomentor.com>
ASSESSMENT_ALERT_EMAIL=asim@thectomentor.com
# Helix / Vigil leads (separate business entity) — defaults to ASSESSMENT_ALERT_EMAIL if unset
VIGIL_ALERT_EMAIL=asim@helixbots.ai

# ESP contact sync (optional — tags: role, tier, lowest dimension)
EMAIL_PLATFORM_API_KEY=
EMAIL_PLATFORM_URL=

# Ad pixels (optional — client)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_REDDIT_PIXEL_ID=

# Server-side Conversions API (optional — call_booked from Cal webhook)
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
LINKEDIN_CAPI_ACCESS_TOKEN=
LINKEDIN_CAPI_CONVERSION_URN=
